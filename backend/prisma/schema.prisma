    generator client {
    provider = "prisma-client-js"
    }

    datasource db {
    provider = "sqlite" // Cambiá por "postgresql" o "mysql" según tu caso
    url      = env("DATABASE_URL")
    }

    model patientUser {
        id              Int     @id @default(autoincrement())
        name            String
        surname         String
        email           String  @unique
        dni             Int     @unique
        password        String
        points          Int     @default(0)
        currentStreak   Int     @default(0)
        longestStreak   Int     @default(0)
        lastStreakUpdate    DateTime?   
        companionId     Int
        companionUser   companionUser   @relation(fields: [companionId], references: [id])
        doctorId        Int
        doctorUser      doctorUser      @relation(fields: [doctorId], references: [id])
    }

    model companionUser {
        id          Int     @id @default(autoincrement())
        name        String
        surname     String
        email       String  @unique
        dni         Int  @unique
        password    String
        patients    patientUser[]
    }

    model doctorUser {
        id      Int     @id @default(autoincrement())
        name    String
        surname String
        email   String  @unique
        dni     Int     @unique
        password    String
        tuition     Int @unique
        patients    patientUser[]
    }